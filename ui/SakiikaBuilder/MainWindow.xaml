<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SakiikaBuilder.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Grid Grid.Row="0" Padding="20,16,20,12" ColumnSpacing="14"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="🦑" FontSize="34" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="さきいかビルダー" FontSize="21" FontWeight="SemiBold" />
                <TextBlock x:Name="ToolchainText"
                           Text="状態を確認中…"
                           FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="DoctorButton" Content="状態を再確認" Click="OnDoctor" />
                <Button x:Name="LoadButton" Content="設定を開く" Click="OnLoadProject" />
                <Button x:Name="SaveButton" Content="設定を保存" Click="OnSaveProject" />
            </StackPanel>
        </Grid>

        <!-- 本体 -->
        <Grid Grid.Row="1" Padding="20,16,20,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="440" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel>

                    <!-- 1. 基本 -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="1. アプリの中身" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource SectionHint}"
                                       Text="HTML が入ったフォルダーを指定します。中のファイルはそのまま assets に入り、各 HTML には JS ブリッジが自動で読み込まれます。" />

                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="HTML フォルダー"
                                           Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="WebRootBox"
                                         PlaceholderText="例: C:\Users\me\Desktop\mysite" />
                                <Button Grid.Row="0" Grid.Column="2" Content="参照…" Click="OnBrowseWebRoot" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="開始ファイル"
                                           Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="EntryBox" Text="index.html" />
                                <Button Grid.Row="1" Grid.Column="2" x:Name="PickEntryButton"
                                        Content="選ぶ…" Click="OnPickEntry" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="出力形式"
                                           Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                          x:Name="FormatCombo" HorizontalAlignment="Stretch"
                                          SelectionChanged="OnFormatChanged">
                                    <ComboBoxItem Content="APK（端末に直接インストール）" Tag="apk" />
                                    <ComboBoxItem Content="AAB（Google Play へのアップロード用）" Tag="aab" />
                                    <ComboBoxItem Content="APK と AAB の両方" Tag="both" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2. アプリ情報 -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="2. アプリの名前とバージョン" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource SectionHint}"
                                       Text="パッケージ名は端末上でアプリを一意に識別する ID です。あとから変えると別アプリ扱いになります。" />

                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="アプリ名"
                                           Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                         x:Name="AppNameBox" Text="マイアプリ" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="パッケージ名"
                                           Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                         x:Name="PackageBox" Text="com.example.myapp" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="バージョン"
                                           Style="{StaticResource FieldLabel}" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="VersionNameBox" Text="1.0" Width="110" />
                                    <NumberBox x:Name="VersionCodeBox" Value="1" Minimum="1" Maximum="2100000000"
                                               SpinButtonPlacementMode="Compact" Width="140"
                                               Header="" PlaceholderText="versionCode" />
                                    <TextBlock Text="（更新のたびに versionCode を増やします）"
                                               VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="対応 Android"
                                           Style="{StaticResource FieldLabel}" />
                                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" Spacing="8">
                                    <NumberBox x:Name="MinSdkBox" Value="26" Minimum="26" Maximum="35"
                                               SpinButtonPlacementMode="Compact" Width="120" />
                                    <TextBlock Text="〜" VerticalAlignment="Center" />
                                    <NumberBox x:Name="TargetSdkBox" Value="34" Minimum="21" Maximum="35"
                                               SpinButtonPlacementMode="Compact" Width="120" />
                                    <TextBlock x:Name="SdkHintText" VerticalAlignment="Center"
                                               FontSize="12" Opacity="0.7" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 3. 見た目 -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="3. 見た目と起動" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource SectionHint}"
                                       Text="テーマを「自動」にすると端末のダークモードに追随し、JS から Android.ui.setDark() で切り替えられます。" />

                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="テーマ"
                                           Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ThemeCombo" MinWidth="200">
                                    <ComboBoxItem Content="自動（端末に合わせる）" Tag="auto" />
                                    <ComboBoxItem Content="常にライト" Tag="light" />
                                    <ComboBoxItem Content="常にダーク" Tag="dark" />
                                </ComboBox>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="画面の向き"
                                           Style="{StaticResource FieldLabel}" />
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="OrientationCombo" MinWidth="200">
                                    <ComboBoxItem Content="指定しない" Tag="unspecified" />
                                    <ComboBoxItem Content="縦向き固定" Tag="portrait" />
                                    <ComboBoxItem Content="横向き固定" Tag="landscape" />
                                    <ComboBoxItem Content="センサーに任せる" Tag="sensor" />
                                </ComboBox>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="背景色"
                                           Style="{StaticResource FieldLabel}" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="LightBgBox" Text="#FFFFFF" Width="110" Header="ライト" />
                                    <TextBox x:Name="DarkBgBox" Text="#121212" Width="110" Header="ダーク" />
                                    <TextBox x:Name="IconBgBox" Text="#1E88E5" Width="110" Header="アイコン背景" />
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="アイコン PNG"
                                           Style="{StaticResource FieldLabel}" />
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="IconBox" Width="240"
                                             PlaceholderText="未指定なら既定のアイコン" />
                                    <Button Content="参照…" Click="OnBrowseIcon" />
                                    <Button Content="消す" Click="OnClearIcon" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,14,0,0" Spacing="6">
                                <ToggleSwitch x:Name="SplashSwitch" IsOn="True"
                                              Header="スプラッシュスクリーン"
                                              OnContent="表示する" OffContent="表示しない（起動を最短にする）" />
                                <TextBlock Style="{StaticResource SectionHint}" Margin="0"
                                           Text="オフにすると、起動時のプレビュー画面を無効化し、Android 12 以降のスプラッシュもアニメーション 0 秒＋初回フレームで除去します。" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <TextBox x:Name="SplashBgBox" Text="#1E88E5" Width="130"
                                             Header="スプラッシュ背景色" />
                                </StackPanel>
                                <CheckBox x:Name="FullscreenCheck" Content="全画面で起動する（ステータスバーを隠す）" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 4. ファイルアクセス -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="4. ファイルへのアクセス" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource SectionHint}"
                                       Text="上から下へ、権限が広がっていきます。必要な範囲だけを選んでください。選んだレベルに必要な権限は自動で付きます。" />
                            <StackPanel x:Name="FileAccessPanel" Spacing="2" />
                            <InfoBar x:Name="FileAccessInfo" IsOpen="False" IsClosable="False"
                                     Severity="Informational" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 5. 権限 -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="5. 使う権限" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="PermissionCountText"
                                               Style="{StaticResource SectionHint}" Margin="0"
                                               Text="読み込み中…" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Top">
                                    <Button Content="必要な分を推測" Click="OnSuggestPermissions" />
                                    <Button Content="全解除" Click="OnClearPermissions" />
                                </StackPanel>
                            </Grid>
                            <TextBox x:Name="PermissionFilterBox" Margin="0,10,0,10"
                                     PlaceholderText="権限を検索（例: カメラ, CAMERA, 位置）"
                                     TextChanged="OnPermissionFilterChanged" />
                            <StackPanel x:Name="PermissionsPanel" Spacing="4" />
                        </StackPanel>
                    </Border>

                    <!-- 6. JS ブリッジ -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="6. JavaScript から使える機能" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource SectionHint}"
                                       Text="チェックしたモジュールだけがアプリに組み込まれます。リフレクションを有効にすると、ここに無い Android API でも JS から直接呼べます。" />

                            <Grid ColumnSpacing="8" RowSpacing="8" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="JS のオブジェクト名"
                                           Style="{StaticResource FieldLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="GlobalNameBox" Text="Android" Width="160" />
                                    <TextBlock x:Name="GlobalNameHint" VerticalAlignment="Center"
                                               FontSize="12" Opacity="0.7" Text="window.Android から呼べます" />
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="ModulesPanel" Spacing="4" />

                            <StackPanel Margin="0,12,0,0" Spacing="4">
                                <CheckBox x:Name="ReflectionCheck" IsChecked="True"
                                          Content="リフレクションを有効にする（任意の Android API を JS から呼べる）" />
                                <CheckBox x:Name="TraceCheck" IsChecked="True"
                                          Content="ブリッジ呼び出しを logcat に記録する（デバッグ時のみ）" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 7. WebView -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="7. WebView の挙動" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource SectionHint}"
                                       Text="迷ったら初期値のままで問題ありません。" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <CheckBox x:Name="JsCheck" IsChecked="True" Content="JavaScript を有効にする" />
                                    <CheckBox x:Name="DomStorageCheck" IsChecked="True" Content="localStorage を使う" />
                                    <CheckBox x:Name="UniversalCheck" IsChecked="True" Content="file:// から外部通信を許す" />
                                    <CheckBox x:Name="MixedCheck" Content="http の混在を許す（非推奨）" />
                                    <CheckBox x:Name="ZoomCheck" Content="ピンチズームを許す" />
                                    <CheckBox x:Name="DebugCheck" IsChecked="True" Content="Chrome から遠隔デバッグする" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <CheckBox x:Name="BackNavCheck" IsChecked="True" Content="戻るボタンで履歴を戻る" />
                                    <CheckBox x:Name="PullRefreshCheck" Content="下に引いて再読み込み" />
                                    <CheckBox x:Name="ExternalLinksCheck" Content="外部リンクをブラウザーで開く" />
                                    <CheckBox x:Name="FileInputCheck" IsChecked="True" Content="input type=file を使う" />
                                    <CheckBox x:Name="MediaCaptureCheck" IsChecked="True" Content="getUserMedia を許す" />
                                    <CheckBox x:Name="GeoCheck" IsChecked="True" Content="JS の位置情報 API を許す" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                                <TextBox x:Name="UaSuffixBox" Width="320"
                                         Header="User-Agent に足す文字（任意）"
                                         PlaceholderText="例: MyApp/1.0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 8. 出力 -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock Text="8. 出力と署名" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource SectionHint}"
                                       Text="署名鍵を指定しない場合は出力フォルダーに sakiika-key.pem を作り、次回以降も同じ鍵で署名します。Android は同じ証明書でないと上書き更新できないため、この鍵は消さずに保管してください。" />

                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="出力フォルダー"
                                           Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="OutputDirBox"
                                         PlaceholderText="未指定なら HTML フォルダーの隣に sakiika-out" />
                                <Button Grid.Row="0" Grid.Column="2" Content="参照…" Click="OnBrowseOutput" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="署名鍵 (.pem)"
                                           Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="KeyBox"
                                         PlaceholderText="未指定なら自動生成して再利用" />
                                <Button Grid.Row="1" Grid.Column="2" Content="参照…" Click="OnBrowseKey" />
                            </Grid>

                            <CheckBox x:Name="ReleaseCheck" Margin="0,10,0,0"
                                      Content="リリース向けにビルドする（デバッグ機能とログを外す）" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ログ -->
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="8">
                    <Button x:Name="BuildButton" Click="OnBuild"
                            HorizontalAlignment="Stretch" Height="46"
                            Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🔨" FontSize="16" />
                            <TextBlock Text="APK をビルド" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="BuildInstallButton" Content="ビルドして端末に入れる"
                                Click="OnBuildAndInstall" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" x:Name="CancelButton" Content="中止" IsEnabled="False"
                                Click="OnCancel" HorizontalAlignment="Stretch" />
                    </Grid>

                    <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ビルドログ" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <CheckBox x:Name="VerboseCheck" Content="詳細" MinWidth="0" />
                                <Button Content="消去" Click="OnClearLog" />
                            </StackPanel>
                        </Grid>
                        <ScrollViewer Grid.Row="1" x:Name="LogScroller" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12"
                                       TextWrapping="NoWrap" IsTextSelectionEnabled="True"
                                       Text="ここにビルドの進行状況が出ます。" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Spacing="6">
                    <Button x:Name="OpenOutputButton" Content="出力フォルダーを開く"
                            Click="OnOpenOutput" HorizontalAlignment="Stretch" IsEnabled="False" />
                    <Button x:Name="InstallLastButton" Content="直前の APK を端末に入れる"
                            Click="OnInstallLast" HorizontalAlignment="Stretch" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ステータス -->
        <Grid Grid.Row="2" Padding="20,8" ColumnSpacing="12"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressRing Grid.Column="0" x:Name="BusyRing" IsActive="False" Width="18" Height="18" />
            <TextBlock Grid.Column="1" x:Name="StatusText" Text="準備完了"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</Window>
